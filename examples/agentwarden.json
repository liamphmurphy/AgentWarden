{
  "providers": {
    "ollama": {
      "name": "Ollama",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "models": {
        "qwen3.5:latest": { "name": "qwen3.5" }
      }
    },
    "gateway": {
      "name": "Gateway",
      "baseUrl": "${GATEWAY_BASE_URL:-https://gateway.example.com/v1}",
      "headers": { "x-api-key": "${GATEWAY_API_KEY}" },
      "models": {
        "sonnet": { "name": "Claude Sonnet" },
        "nemotron": { "name": "Nemotron" }
      }
    }
  },

  "defaultModel": "ollama/qwen3.5:latest",
  "defaultAgent": "orchestrator",

  "agentDirs": [".config/agentwarden/agent", ".agentwarden/agent"],
  "skillDirs": [".config/agentwarden/skills", ".agentwarden/skills"],

  "workflow": {
    "enabled": true,
    "policy": ".agentwarden/workflow.yml"
  }
}
